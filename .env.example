# O exemplo do Notion usa armazenamento em memoria (nao precisa de XAMPP)
DB_MODE=memory

# Para conectar a um MySQL local do XAMPP, mude para DB_MODE=mysql:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=api_express

# Opcional: habilita verificacao de token nas rotas da API (o HTML de exemplo nao envia token)
# API_TOKEN=seu_token_de_teste
